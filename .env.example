# Development only. Never use these example credentials outside loopback.
POSTGRES_PASSWORD=links-local-only
DATABASE_URL=postgresql://links:links-local-only@127.0.0.1:5432/links
LINKS_TEST_DATABASE_URL=postgresql://links:links-local-only@127.0.0.1:5432/links

# Optional auth service. Supply real credentials through your secret manager.
# Leave blank until configured; no development OTP bypass exists.
AUTH_BIND=127.0.0.1:8080
AUTH_LOOKUP_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional passkey service. Set both or neither. Use a real HTTPS origin outside localhost.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
